# ============================================================
# VORLAGE: nach .env.local (Repo-Root) kopieren und ausfuellen.
# Die echte .env.local ist gitignored.
# Praefix MUSIC_ -> BeatByte, SOUNDBOARD_ -> EarTastic.
# libs/loadEnv.js entfernt den Praefix beim Bot-Start; bereits
# gesetzte Umgebungsvariablen gewinnen immer.
# Prod laeuft NUR ueber Coolify-Env (im Container existiert diese
# Datei nicht). Die Root-.env ist die Prod-Vorlage fuer Coolify.
# ============================================================

# ── BeatByte Dev (music-bot) ─────────────────────────────────
# Developer Portal -> Dev-App -> Bot -> Reset Token
MUSIC_DISCORD_TOKEN=HIER-EINTRAGEN-dev-bot-token
# Developer Portal -> General Information -> Application ID
MUSIC_CLIENT_ID=HIER-EINTRAGEN-application-id
# Test-Server-ID — fuer den DEV-Bot gewollt (Commands sofort sichtbar).
# ACHTUNG beim manuellen PROD-Command-Deploy: Zeile auskommentieren!
# (Prod-Music-Bot ist GLOBAL registriert, GUILD_ID gaebe doppelte Commands.)
MUSIC_GUILD_ID=HIER-EINTRAGEN-test-server-id
MUSIC_API_PORT=3001
MUSIC_API_KEY=hier-langen-zufallswert-eintragen
MUSIC_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
MUSIC_APP_URL=http://localhost:3001
MUSIC_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
# Optional: Fehler-/Crash-Alerts an einen Discord-Webhook (libs/notify.js).
# Ohne Wert: aus (No-op). In Prod als ALERT_WEBHOOK_URL in Coolify setzen.
# Webhook: Discord -> Kanal -> Integrationen -> Webhooks -> Neuer Webhook -> URL.
#MUSIC_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Optional: periodischer #status-Post (libs/status.js) — Kanal-ID des #status-Kanals.
# Ohne Wert: aus (No-op). Bot braucht dort View/Send/Embed/Read-History-Rechte.
#MUSIC_STATUS_CHANNEL_ID=123456789012345678
# Optional: Web-Player-Login testen (Portal -> OAuth2 -> Client Secret,
# Redirect-URI dort ebenfalls eintragen)
#MUSIC_DISCORD_CLIENT_SECRET=
# Optional: Spotify (Werte liegen nur in Coolify; eigene Keys:
# developer.spotify.com/dashboard). Ohne Keys: "nicht konfiguriert".
#MUSIC_SPOTIFY_CLIENT_ID=
#MUSIC_SPOTIFY_CLIENT_SECRET=
# YouTube lokal: direct = yt-dlp ohne Proxy/POT ueber die lokale IP
# (die Coolify-Aliasse warp:1080 / pot-provider:4416 gibt es nur im Server-Netz).
#MUSIC_YTDLP_PROXY=direct
#MUSIC_POT_PROVIDER_URL=
# yt-dlp-Binary fuer /play (das gebuendelte braucht Python 3.10+):
# aktuelles yt-dlp ablegen und absoluten Pfad hier setzen.
#MUSIC_YTDLP_PATH=/absoluter/pfad/zu/yt-dlp

# ── EarTastic Dev (soundboard-bot) ───────────────────────────
SOUNDBOARD_DISCORD_TOKEN=HIER-EINTRAGEN-dev-bot-token
SOUNDBOARD_CLIENT_ID=HIER-EINTRAGEN-application-id
# Laufzeit-Guild fuer den Dashboard-Login (prueft Guild-Mitgliedschaft). Anders als
# beim Music-Bot NICHT der Command-Scope — dafuer SOUNDBOARD_COMMANDS_GUILD_ID unten.
# Gleicher Test-Server wie beim Music-Dev-Bot ist ok.
SOUNDBOARD_GUILD_ID=HIER-EINTRAGEN-test-server-id
# Command-Scope beim `npm run deploy` (getrennt vom GUILD_ID oben): gesetzt ->
# Commands sofort in dieser Guild sichtbar (Dev). In Prod/Coolify UNGESETZT lassen
# -> Commands GLOBAL (auf allen Servern). Meist dieselbe Test-Server-ID wie oben.
SOUNDBOARD_COMMANDS_GUILD_ID=HIER-EINTRAGEN-test-server-id
SOUNDBOARD_WEB_PORT=3002
SOUNDBOARD_API_KEY=hier-langen-zufallswert-eintragen
# Signatur-Secret der Dashboard-Sessions, getrennt vom API_KEY (eigener Zufallswert,
# z.B. `openssl rand -hex 32`). Fehlt es, faellt der Code auf API_KEY zurueck.
SOUNDBOARD_SESSION_SECRET=hier-eigenen-zufallswert-eintragen
SOUNDBOARD_ALLOWED_ORIGINS=http://localhost:3002
SOUNDBOARD_FREESOUND_API_KEY=
SOUNDBOARD_OAUTH_REDIRECT_URI=http://localhost:3002/api/auth/discord/callback
# Optional: Fehler-/Crash-Alerts an einen Discord-Webhook (libs/notify.js).
# Ohne Wert: aus (No-op). In Prod als ALERT_WEBHOOK_URL in Coolify setzen.
#SOUNDBOARD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Optional: periodischer #status-Post (libs/status.js) — Kanal-ID des #status-Kanals.
# Ohne Wert: aus (No-op). Bot braucht dort View/Send/Embed/Read-History-Rechte.
# Gleiche Kanal-ID wie beim music-bot -> beide posten in denselben #status-Kanal.
#SOUNDBOARD_STATUS_CHANNEL_ID=123456789012345678
# Optional: Dashboard-Login testen (Portal -> OAuth2 -> Client Secret)
#SOUNDBOARD_DISCORD_CLIENT_SECRET=

# ── Server-Inspektion / Admin (read-only, nur fuer Tooling) ──
# Token eines eigenen read-only Bots ("ByteBots Admin") fuer scripts/discord-inspect.js
# (liest Kanaele/Rollen/Community-Status per REST). NICHT den Prod-Token verwenden!
# Kein MUSIC_/SOUNDBOARD_-Praefix -> loadEnv.js ignoriert es, die Bots sehen es nie.
#
# Einrichten (einmalig, im Discord Developer Portal):
#  1. discord.com/developers/applications -> New Application "ByteBots Admin"
#  2. Tab "Bot" -> Token "Reset Token" -> kopieren -> hier unten eintragen
#     (KEINE privilegierten Intents noetig; das Skript nutzt nur REST)
#  3. Auf den Support-Server einladen, minimal read-only (scope=bot, nur "Kanaele ansehen"):
#     https://discord.com/oauth2/authorize?client_id=<NEUE_APP_CLIENT_ID>&permissions=1024&scope=bot
ADMIN_DISCORD_TOKEN=HIER-EINTRAGEN-admin-bot-token
SUPPORT_GUILD_ID=1525977525400895668
