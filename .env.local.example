# ============================================================
# VORLAGE: nach .env.local (Repo-Root) kopieren und ausfuellen.
# Die echte .env.local ist gitignored.
# Praefix MUSIC_ -> BeatByte, SOUNDBOARD_ -> EarTastic.
# libs/loadEnv.js entfernt den Praefix beim Bot-Start; bereits
# gesetzte Umgebungsvariablen gewinnen immer.
# Prod laeuft NUR ueber Coolify-Env (im Container existiert diese
# Datei nicht). Die Root-.env ist die Prod-Vorlage fuer Coolify.
# ============================================================

# ── BeatByte Dev (music-bot) ─────────────────────────────────
# Developer Portal -> Dev-App -> Bot -> Reset Token
MUSIC_DISCORD_TOKEN=HIER-EINTRAGEN-dev-bot-token
# Developer Portal -> General Information -> Application ID
MUSIC_CLIENT_ID=HIER-EINTRAGEN-application-id
# Test-Server-ID — fuer den DEV-Bot gewollt (Commands sofort sichtbar).
# ACHTUNG beim manuellen PROD-Command-Deploy: Zeile auskommentieren!
# (Prod-Music-Bot ist GLOBAL registriert, GUILD_ID gaebe doppelte Commands.)
MUSIC_GUILD_ID=HIER-EINTRAGEN-test-server-id
MUSIC_API_PORT=3001
MUSIC_API_KEY=hier-langen-zufallswert-eintragen
MUSIC_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
MUSIC_APP_URL=http://localhost:3001
MUSIC_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
# Optional: Web-Player-Login testen (Portal -> OAuth2 -> Client Secret,
# Redirect-URI dort ebenfalls eintragen)
#MUSIC_DISCORD_CLIENT_SECRET=
# Optional: Spotify (Werte liegen nur in Coolify; eigene Keys:
# developer.spotify.com/dashboard). Ohne Keys: "nicht konfiguriert".
#MUSIC_SPOTIFY_CLIENT_ID=
#MUSIC_SPOTIFY_CLIENT_SECRET=
# YouTube lokal: Die Code-Defaults (warp:1080 / pot-provider:4416)
# existieren nur im Coolify-Netz -> /play schlaegt lokal fehl,
# solange der Code keinen "ohne Proxy"-Wert kennt.
#MUSIC_YTDLP_PROXY=
#MUSIC_POT_PROVIDER_URL=

# ── EarTastic Dev (soundboard-bot) ───────────────────────────
SOUNDBOARD_DISCORD_TOKEN=HIER-EINTRAGEN-dev-bot-token
SOUNDBOARD_CLIENT_ID=HIER-EINTRAGEN-application-id
# Gleicher Test-Server wie beim Music-Dev-Bot ist ok
SOUNDBOARD_GUILD_ID=HIER-EINTRAGEN-test-server-id
SOUNDBOARD_WEB_PORT=3002
SOUNDBOARD_API_KEY=hier-langen-zufallswert-eintragen
SOUNDBOARD_ALLOWED_ORIGINS=http://localhost:3002
SOUNDBOARD_FREESOUND_API_KEY=
SOUNDBOARD_OAUTH_REDIRECT_URI=http://localhost:3002/api/auth/discord/callback
# Optional: Dashboard-Login testen (Portal -> OAuth2 -> Client Secret)
#SOUNDBOARD_DISCORD_CLIENT_SECRET=
